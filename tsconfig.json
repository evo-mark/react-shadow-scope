{
	"compilerOptions": {
		"declaration": true,
		"strict": true,
		"jsx": "react",
		"module": "esnext",
		"target": "ESNext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"types": ["react"],
		"isolatedModules": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src", "test"]
}
